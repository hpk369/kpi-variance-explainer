# Copy to .env and fill in. .env is never committed.
# The HF Space uses the same names as Space secrets (except DATABRICKS_USER).
DATABRICKS_HOST=https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_USER=you@example.com

VS_ENDPOINT=cib_vs_endpoint
VS_INDEX=cib_demo.gold.doc_chunks_idx

# Bare model names (the code adds system.ai. or databricks- and picks the working address)
LLM_ENDPOINT=qwen35-122b-a10b
LLM_FALLBACK_ENDPOINT=gpt-oss-120b
# Optional: the model that writes the answer (default gpt-oss-120b from config/constants.yaml)
# DRAFT_ENDPOINT=gpt-oss-120b
EMBEDDING_ENDPOINT=gte-large-en
